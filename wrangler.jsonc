{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "pseo-plumbing-site",
  "account_id": "4f98884c905792ecc294a9d77b3c17fd",
  "compatibility_date": "2024-12-30",
